# Local Postgres only (see docker-compose.yml / npm run db:up). Never point at AWS RDS.
DATABASE_URL=postgres://judge:judge@127.0.0.1:5432/synthkit

# --- Live xAI keys (not required for unit tests or EVAL_LLM_STUB / RAG_EMBED_STUB) ---
# XAI_API_KEY: judge, generate-then-judge, live embeddings, subject complete.
XAI_API_KEY=
# XAI_API_KEY2: question synthesis agent only (synth generate / POST /api/synthesize).
# Do not reuse XAI_API_KEY for synthesis.
# XAI_API_KEY2=

# Optional model overrides (defaults in src/lib/eval/models.ts).
# JUDGE_MODEL=
# SYNTHESIS_MODEL=

# --- Stubs (CI / no network) ---
# EVAL_LLM_STUB=1  → judge, generate, and synthesis use injected/stub completions (no xAI).
# RAG_EMBED_STUB=1 → bag-of-tokens embeddings (STUB_EMBED_DIM=768), no live embed API.
# EVAL_LLM_STUB=1
# RAG_EMBED_STUB=1
# RAG_EMBED_MODEL=grok-embedding-small

# --- Connectors (never commit JSON keys or PATs) ---
# Vertex AI Search / Discovery Engine data store:
# GCP_ACCESS_TOKEN=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Databricks Unity Catalog vector search index:
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_TOKEN=
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=
