# Local Postgres only (see docker-compose.yml / npm run db:up). Never point at AWS RDS.
DATABASE_URL=postgres://judge:judge@127.0.0.1:5432/judge_dredd

# xAI API keys for live judge/generate calls (optional for unit tests).
XAI_API_KEY=
# Second key: question synthesis agent (/api/synthesize). Required for that path.
# XAI_API_KEY2=

# Optional judge model override (defaults in src/lib/eval/models.ts).
# JUDGE_MODEL=
# Optional synthesis model (defaults to the same low-cost judge model).
# SYNTHESIS_MODEL=

# Set to 1 to force stub LLM paths where supported.
# EVAL_LLM_STUB=1
